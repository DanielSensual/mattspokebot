# Matt's Pokemon Center Bot — Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# POKEMON CENTER SESSION
# Export cookies from a logged-in browser session
# Run: npm run cookies:export  (or paste cookies manually)
# =============================================================================
POKEMON_CENTER_COOKIES=

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
# Poll interval in seconds (minimum 30, recommended 60-90)
POLL_INTERVAL_SECONDS=60

# Jitter range in seconds (randomizes ± this amount around poll interval)
POLL_JITTER_SECONDS=15

# Max consecutive failures before pausing a product (default 10)
MAX_FAILURES_BEFORE_PAUSE=10

# =============================================================================
# CHECKOUT SETTINGS
# =============================================================================
# Use store credits for payment (default: true)
USE_STORE_CREDITS=true

# Maximum spend per purchase in dollars (safety limit)
MAX_PURCHASE_AMOUNT=500

# Dry run mode — goes through checkout flow without placing order
DRY_RUN=false

# Take screenshots during checkout (saved to ./screenshots/)
SCREENSHOTS_ENABLED=true

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=

# Twilio SMS (optional — for critical alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=

# =============================================================================
# PROXY (optional but recommended for production)
# =============================================================================
# Format: http://user:pass@host:port or socks5://user:pass@host:port
PROXY_URL=

# =============================================================================
# BROWSER SETTINGS
# =============================================================================
# Run browser in headless mode (default: true, set false for debugging)
HEADLESS=true

# Browser executable path (leave empty for Playwright's bundled Chromium)
BROWSER_PATH=

# =============================================================================
# SYSTEM
# =============================================================================
NODE_ENV=production
TZ=America/New_York
